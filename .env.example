# Copy to .env and fill in. Never commit .env.

# --- Option A: SQL authentication ---
AZURE_SQL_SERVER=your-server.database.windows.net
AZURE_SQL_DATABASE=your-database
AZURE_SQL_USER=your-user
AZURE_SQL_PASSWORD=your-password

# --- Option B: Entra ID (Azure AD) sign-in instead of user/password ---
# Set AZURE_SQL_AUTH=aad and leave USER/PASSWORD empty. Uses DefaultAzureCredential:
# `az login` locally, or a managed identity when deployed.
# AZURE_SQL_AUTH=aad

# Schema that holds the vw_ops_* views (default dbo)
AZURE_SQL_SCHEMA=dbo

# Seconds to cache each query's rows in memory before hitting SQL again
CACHE_TTL_SECONDS=300

PORT=3000

